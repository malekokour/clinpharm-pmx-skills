.DS_Store
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
_qa/
dist/
*.pdf
!docs/assets/**
!site/assets/**

# Re-include files that a machine-level global gitignore may exclude.
# `~/.gitignore_global` on the maintainer's machine ignores `*.xml`, which
# silently dropped site/sitemap.xml — a file scripts/validate_repo.py lists as
# required. The repository would have passed locally and failed `make check` on
# a fresh clone. Repository rules take precedence over core.excludesFile, so the
# negation belongs here rather than in anyone's machine configuration.
!site/sitemap.xml

# Agent / tooling local state — never publish
.claude-flow/
*.bak
*.bak-*
